@startuml

  skinparam svek                  true
  skinparam ClassBackgroundColor  #F3EFEB/CCC9C5
  skinparam ClassArrowColor       #691616
  skinparam ClassBorderColor      #691616
  skinparam NoteBackgroundColor   #F3EFEB
  skinparam NoteBorderColor       #691616
  skinparam NoteFontColor         #691616
  skinparam ClassFontSize         11
  skinparam PackageFontSize       12
  skinparam linetype              ortho

  package org.hipparchus #ECEBD8 {

    interface "FieldElement<T>" as FieldElement_T {
      +double getReal()
      +add()
      +subtract()
      +multiply()
      +divide()
      +negate()
      +reciprocal()
      +Field<T> getField()
    }

    interface "CalculusFieldElement<T>" as CalculusFieldElement_T {
     +sqrt()
     +sin()
     +"...()"
    }

    interface "Field<T>" as Field_T {
      T getZero()
      T getOne()
    }

    FieldElement_T <|.. CalculusFieldElement_T
    FieldElement_T <-- Field_T

    package analysis #DDEBD8 {

      package differentiation #CBDBC8 {
        interface DifferentialAlgebra {
          +int getFreeParameters()
          +int getOrder()
        }
        interface Derivative
        interface Derivative1
        class UnivariateDerivative1
        class Gradient
        class SparseGradient
        class DerivativeStructure
        Derivative .right.|> CalculusFieldElement_T
        DifferentialAlgebra <|.. Derivative
        Derivative <|.. Derivative1
        Derivative1 <|-- UnivariateDerivative1
        Derivative1 <|-- Gradient
        Derivative1 <|-- SparseGradient
        Derivative <|-left- DerivativeStructure
      }

    }

  }

@enduml
